<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net48</TargetFramework>
    <PlatformTarget>x86</PlatformTarget>
    <DspNeedsGameDll>true</DspNeedsGameDll>
    <UseWPF>true</UseWPF>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>DspSearcher</RootNamespace>
    <AssemblyName>DspSearcher</AssemblyName>
    <ServerGarbageCollection>true</ServerGarbageCollection>
    <GenerateMainWpf>false</GenerateMainWpf>
    <StartupObject>DspSearcher.App</StartupObject>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\DspCore48\DspCore48.csproj" />
  </ItemGroup>
  <ItemGroup>
    <Reference Include="Assembly-CSharp">
      <HintPath>$(DspManagedDir)\Assembly-CSharp.dll</HintPath>
    </Reference>
    <Reference Include="UnityEngine">
      <HintPath>$(DspManagedDir)\UnityEngine.dll</HintPath>
    </Reference>
    <Reference Include="UnityEngine.CoreModule">
      <HintPath>$(DspManagedDir)\UnityEngine.CoreModule.dll</HintPath>
    </Reference>
    <Reference Include="UnityEngine.SharedInternalsModule">
      <HintPath>$(DspManagedDir)\UnityEngine.SharedInternalsModule.dll</HintPath>
    </Reference>
    <PackageReference Include="Newtonsoft.Json" Version="13.0.1" />
  </ItemGroup>
  <ItemGroup>
    <None Include="data\balance.json" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\DspCore48\prototypes\**" Link="prototypes\%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>