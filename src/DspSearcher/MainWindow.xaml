<Window x:Class="DspSearcher.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="DSP 地图搜索器" Height="760" Width="1280" WindowStartupLocation="CenterScreen">
    <DockPanel Margin="8">

        <!-- 顶部：条件面板 + 按钮 -->
        <StackPanel DockPanel.Dock="Top">
            <GroupBox Header="搜索条件">
                <StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                    <TextBlock Text="单种子精算:" VerticalAlignment="Center"/>
                    <TextBox x:Name="TxtSeed" Width="100" Text="" Margin="6,0,0,0"/>
                    <Button x:Name="BtnSingle" Content="精算该种子" Width="90" Margin="6,0,0,0" Click="OnSingle"/>
                    <TextBlock Text="（不过滤：完整生成 + 地形 + 矿脉，输出单行 results.csv）" Foreground="Gray" Margin="8,0,0,0" VerticalAlignment="Center"/>
                </StackPanel>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/><ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/><ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" Margin="4">
                        <TextBlock Text="种子范围（起始 ~ 结束）"/>
                        <StackPanel Orientation="Horizontal">
                            <TextBox x:Name="TxtFrom" Width="70" Text="0"/>
                            <TextBlock Text=" ~ "/>
                            <TextBox x:Name="TxtTo" Width="90" Text="99999999"/>
                        </StackPanel>
                        <TextBlock Text="线程数"/>
                        <TextBox x:Name="TxtThreads" Width="70" Text="32"/>
                        <TextBlock Text="精算线程"/>
                        <TextBox x:Name="TxtRefineThreads" Width="70" Text="32"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Margin="4">
                        <TextBlock Text="4.1 O星数量 ≥"/>
                        <TextBox x:Name="TxtMinO" Width="50" Text="3"/>
                        <TextBlock Text="4.2 近≤ / 远≥ (ly, 优先加分)"/>
                        <StackPanel Orientation="Horizontal">
                            <TextBox x:Name="TxtNear" Width="50" Text="8"/>
                            <TextBlock Text=" / "/>
                            <TextBox x:Name="TxtFar" Width="50" Text="15"/>
                        </StackPanel>
                    </StackPanel>
                    <StackPanel Grid.Column="2" Margin="4">
                        <TextBlock Text="4.4 覆盖半径 (ly)"/>
                        <TextBox x:Name="TxtRadius" Width="50" Text="6"/>
                        <CheckBox x:Name="ChkIceGiant" Content="4.3 母星系须含冰巨星（强制）" IsChecked="True" Margin="0,6,0,0"/>
                    </StackPanel>
                    <StackPanel Grid.Column="3" Margin="4">
                        <TextBlock Text="快筛 top 池容量"/>
                        <TextBox x:Name="TxtPoolSize" Width="50" Text="500"/>
                        <TextBlock Text="气巨采集站固定 40（游戏上限）" Foreground="Gray" Margin="0,6,0,0"/>
                    </StackPanel>
                    <StackPanel Grid.Column="4" Margin="4" VerticalAlignment="Bottom">
                        <TextBlock Text="配比: 合并（矩阵10万/min + 戴森球）"/>
                        <TextBlock Text="产出: top20.csv / galaxies / report" Foreground="Gray"/>
                    </StackPanel>
                </Grid>
                </StackPanel>
            </GroupBox>

            <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                <Button x:Name="BtnFastScan" Content="FastScan 快筛" Width="100" Margin="6,0,0,0" Click="OnFastScan"/>
<Button x:Name="BtnStart" Content="开始搜索" Width="90" Click="OnStart"/>
                <Button x:Name="BtnPause" Content="暂停" Width="70" Margin="6,0,0,0" Click="OnPause" IsEnabled="False"/>
                <Button x:Name="BtnResume" Content="恢复(读检查点)" Width="110" Margin="6,0,0,0" Click="OnResume"/>
                <Button x:Name="BtnStop" Content="停止" Width="70" Margin="6,0,0,0" Click="OnStop" IsEnabled="False"/>
                <TextBlock x:Name="TxtStatus" Text="就绪" Margin="16,0,0,0" VerticalAlignment="Center" FontWeight="Bold"/>
            </StackPanel>
        </StackPanel>

        <!-- 中部：进度 -->
        <GroupBox DockPanel.Dock="Top" Header="进度" Margin="0,6,0,6">
            <StackPanel>
                <ProgressBar x:Name="Prog" Height="18"/>
                <TextBlock x:Name="TxtProgress" Text="已扫 0 / 0   命中 0   速率 -   预计剩余 -" Margin="0,4,0,0"/>
            </StackPanel>
        </GroupBox>

        <!-- 中部：TOP 表格 -->
        <GroupBox DockPanel.Dock="Top" Header="TOP 候选（实时，快筛理论分排序）" Margin="0,0,0,6">
            <DataGrid x:Name="Grid" AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="Column"
                      CanUserAddRows="False" CanUserDeleteRows="False" Height="300">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="排名" Binding="{Binding Rank}" Width="50"/>
                    <DataGridTextColumn Header="种子" Binding="{Binding Seed}" Width="90"/>
                    <DataGridTextColumn Header="≈小时" Binding="{Binding Hours}" Width="60"/>
                    <DataGridTextColumn Header="瓶颈" Binding="{Binding Bottleneck}" Width="70"/>
                    <DataGridTextColumn Header="O星" Binding="{Binding OStarCount}" Width="45"/>
                    <DataGridTextColumn Header="黑/中" Binding="{Binding SpecText}" Width="60"/>
                    <DataGridTextColumn Header="距离近~远" Binding="{Binding DistText}" Width="100"/>
                    <DataGridTextColumn Header="4.2" Binding="{Binding PairOkText}" Width="45"/>
                    <DataGridTextColumn Header="冰巨卫星数" Binding="{Binding HomeIceSatellites}" Width="80"/>
                    <DataGridTextColumn Header="最近O星(ly)" Binding="{Binding MinOStarDist, StringFormat=F1}" Width="90"/>
                    <DataGridTextColumn Header="6ly行星" Binding="{Binding PlanetsIn6Ly}" Width="70"/>
                </DataGrid.Columns>
            </DataGrid>
        </GroupBox>

        <!-- 底部：日志 -->
        <GroupBox Header="日志" Margin="0,0,0,0">
            <TextBox x:Name="TxtLog" IsReadOnly="True" TextWrapping="NoWrap" VerticalScrollBarVisibility="Auto"
                     Height="140" FontFamily="Consolas" FontSize="12"/>
        </GroupBox>
    </DockPanel>
</Window>
