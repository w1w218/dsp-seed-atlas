<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <PlatformTarget>x64</PlatformTarget>
    <DspNeedsGameDll>true</DspNeedsGameDll>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <AssemblyName>DspSave</AssemblyName>
    <RootNamespace>DspSave</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <!-- 复用 DspSearcher 的存档融合实现（同一份源码，net48 小档 / net8 大档双入口） -->
    <Compile Include="..\DspSearcher\Merge.cs" Link="Merge.cs" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\DspCore48\DspCore48.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Newtonsoft.Json" Version="13.0.1" />
    <Reference Include="UnityEngine">
      <HintPath>$(DspManagedDir)\UnityEngine.dll</HintPath>
    </Reference>
    <Reference Include="UnityEngine.CoreModule">
      <HintPath>$(DspManagedDir)\UnityEngine.CoreModule.dll</HintPath>
    </Reference>
    <Reference Include="UnityEngine.SharedInternalsModule">
      <HintPath>$(DspManagedDir)\UnityEngine.SharedInternalsModule.dll</HintPath>
    </Reference>
    <Reference Include="Assembly-CSharp">
      <HintPath>$(DspManagedDir)\Assembly-CSharp.dll</HintPath>
    </Reference>
  </ItemGroup>

  <ItemGroup>
    <None Include="..\DspCore48\prototypes\**" Link="prototypes\%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
